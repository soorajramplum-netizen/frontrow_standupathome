# Copy to .env.local for local runs; on Vercel add these under Project > Settings > Environment Variables.
# Never commit real keys. Without any key the app still works: replies come from the line bank.
#
# The AI chain: providers are tried in AI_PROVIDER_ORDER, each with its own free allowance.
AI_PROVIDER_ORDER=groq,gemini,openrouter
# Fill a provider's KEY and MODELS to switch it on; leave them empty to skip it.
# One key per provider (several accounts on the same provider usually breaks their terms).

# 1. OpenRouter: https://openrouter.ai/keys . Free models end in ":free": https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,particle-ai/particle-1:free,recursive/flint-v1.0:free
# About 50 free requests/day without credits (about 1,000 after a one-time $10 top-up).
OPENROUTER_DAILY_BUDGET=45

# 2. Google AI Studio (Gemini): https://aistudio.google.com/apikey . Model names: see their models page.
GEMINI_API_KEY=
GEMINI_MODELS=
GEMINI_DAILY_BUDGET=200

# 3. Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=
GROQ_DAILY_BUDGET=200

# 4. Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODELS=
CEREBRAS_DAILY_BUDGET=200

# 5. Mistral: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODELS=
MISTRAL_DAILY_BUDGET=100
